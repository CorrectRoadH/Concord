{
  "plugins": [
    "import",
    "typescript",
    "unicorn"
  ],
  "categories": {
    "correctness": "off"
  },
  "rules": {
    "unicorn/filename-case": [
      "error",
      {
        "case": "kebabCase"
      }
    ],
    "import/no-default-export": "error",
    "typescript/consistent-type-imports": [
      "error",
      {
        "prefer": "type-imports"
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "src/entry/herdr-mod/main.ts",
        "bench/*.bench.ts",
        "*.config.ts"
      ],
      "rules": {
        "import/no-default-export": "off"
      }
    }
  ]
}
