{
  "name": "concord-sdlc",
  "version": "0.7.3",
  "description": "Contract, test evidence, and engineering memory for a repository's development lifecycle.",
  "type": "module",
  "private": true,
  "bin": {
    "concord": "dist/entry.js"
  },
  "files": [
    "dist",
    "README.md",
    "docs",
    "NOTICE.md",
    "npm-shrinkwrap.json",
    "repository",
    "templates",
    "skills"
  ],
  "engines": {
    "node": ">=24.15.0"
  },
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "build": "tsx scripts/build.ts",
    "typecheck": "pnpm build && tsc -p tsconfig.test.json && tsc -p tsconfig.scripts.json",
    "test": "pnpm build && pnpm test:built",
    "check": "pnpm typecheck && pnpm test:built",
    "concord": "node dist/entry.js",
    "test:built": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-rc.112",
    "@effect/platform-node-shared": "4.0.0-rc.112",
    "effect": "4.0.0-rc.112",
    "mdast-util-from-markdown": "2.0.3",
    "mermaid": "11.12.2",
    "shiki": "4.3.0",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@codemirror/commands": "6.11.0",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.4",
    "@codemirror/view": "6.43.11",
    "@fontsource-variable/noto-sans-sc": "5.3.0",
    "@lezer/highlight": "1.2.3",
    "@mdxeditor/editor": "4.2.5",
    "@playwright/test": "1.63.0",
    "@stylexjs/stylex": "0.19.0",
    "@stylexjs/unplugin": "0.19.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/mdast": "4.0.4",
    "@types/node": "24.13.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.45.0",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-diff-view": "3.3.3",
    "react-dom": "19.3.0",
    "react-grab": "0.2.0",
    "react-markdown": "10.1.0",
    "react-router-dom": "7.18.3",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "unplugin": "2.3.11",
    "vite": "8.3.0",
    "vitest": "4.1.11"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.0-rc.112"
  },
  "exports": {
    "./document-codec": {
      "types": "./dist/document-codec.d.ts",
      "default": "./dist/document-codec.js"
    },
    "./document-layout": {
      "types": "./dist/document-layout.d.ts",
      "default": "./dist/document-layout.js"
    },
    "./design-content": {
      "types": "./dist/design-content.d.ts",
      "default": "./dist/design-content.js"
    },
    "./templates": {
      "types": "./dist/templates.d.ts",
      "default": "./dist/templates.js"
    },
    "./governance-config": {
      "types": "./dist/governance-config.d.ts",
      "default": "./dist/governance-config.js"
    },
    "./evidence-policy": {
      "types": "./dist/evidence-policy.d.ts",
      "default": "./dist/evidence-policy.js"
    },
    "./memory-state": {
      "types": "./dist/memory-state.d.ts",
      "default": "./dist/memory-state.js"
    },
    "./coordination": {
      "types": "./dist/coordination.d.ts",
      "default": "./dist/coordination.js"
    },
    "./model": {
      "types": "./dist/shared.d.ts",
      "default": "./dist/shared.js"
    },
    "./config": {
      "types": "./dist/config-public.d.ts",
      "default": "./dist/config-public.js"
    },
    "./repository/*": {
      "types": "./dist/repository/*.d.ts",
      "default": "./dist/repository/*.js"
    },
    "./package.json": "./package.json"
  }
}
