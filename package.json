{
  "name": "concord-sdlc",
  "version": "dev",
  "description": "Contract, test evidence, and engineering memory for a repository's development lifecycle.",
  "type": "module",
  "private": true,
  "bin": {
    "concord": "dist/entry/cli/entry.js"
  },
  "files": [
    "dist",
    "README.md",
    "docs",
    "pnpm-workspace.yaml",
    "templates",
    "skills"
  ],
  "engines": {
    "node": ">=24.15.0"
  },
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "build": "vp build",
    "check": "node --import tsx scripts/check.ts",
    "concord": "node --import tsx src/entry/cli/entry.ts",
    "bench": "node --import tsx scripts/bench.ts",
    "bench:profile": "node --import tsx scripts/profile.ts",
    "test:e2e:agent": "node --import tsx scripts/test-built.ts --suite=agent",
    "build:native": "node --import tsx scripts/build-native.ts --reuse"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-rc.112",
    "@effect/platform-node-shared": "4.0.0-rc.112",
    "effect": "4.0.0-rc.112",
    "esbuild": "0.28.2",
    "ink": "8.0.0",
    "mdast-util-from-markdown": "2.0.3",
    "react": "19.3.0",
    "string-width": "8.3.0",
    "tsx": "4.23.12",
    "typescript": "7.1.0-beta",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@ai-sdk/openai": "4.0.90",
    "@codemirror/commands": "6.11.0",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.4",
    "@codemirror/view": "6.43.11",
    "@e2e-dev/web": "0.15.2",
    "@fontsource-variable/noto-sans-sc": "5.3.0",
    "@jridgewell/sourcemap-codec": "1.6.0",
    "@lezer/highlight": "1.2.3",
    "@mdxeditor/editor": "4.2.5",
    "@playwright/test": "1.64.0",
    "@stylexjs/stylex": "0.19.0",
    "@stylexjs/unplugin": "0.19.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/mdast": "4.0.4",
    "@types/node": "24.13.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "ai": "7.0.107",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "e2e": "0.21.2",
    "katex": "0.16.47",
    "lucide-react": "1.45.0",
    "mermaid": "11.12.2",
    "p5": "2.3.4",
    "p5.brush": "2.2.3",
    "p5.sound": "0.4.1",
    "radix-ui": "1.6.7",
    "react-diff-view": "3.3.3",
    "react-dom": "19.3.0",
    "react-grab": "0.2.0",
    "react-markdown": "10.1.0",
    "react-router-dom": "7.18.3",
    "rehype-katex": "7.0.1",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "shiki": "4.3.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "unified": "11.0.5",
    "unplugin": "2.3.11",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vitest": "4.1.11",
    "vite-plus": "1.3.0"
  },
  "imports": {
    "#typescript-host": {
      "concord-source": "./src/base/process/typescript-host.ts",
      "types": "./dist/base/process/typescript-host.d.ts",
      "default": "./dist/base/process/typescript-host.js"
    }
  },
  "exports": {
    "./config": {
      "concord-source": "./src/model/config-public.ts",
      "types": "./dist/model/config-public.d.ts",
      "default": "./dist/model/config-public.js"
    },
    "./model": {
      "concord-source": "./src/model/index.ts",
      "types": "./dist/model/index.d.ts",
      "default": "./dist/model/index.js"
    },
    "./test-adapter-protocol": {
      "concord-source": "./src/model/test-adapter-protocol.ts",
      "types": "./dist/model/test-adapter-protocol.d.ts",
      "default": "./dist/model/test-adapter-protocol.js"
    },
    "./change-preview": {
      "concord-source": "./src/model/change-preview.ts",
      "types": "./dist/model/change-preview.d.ts",
      "default": "./dist/model/change-preview.js"
    }
  }
}
