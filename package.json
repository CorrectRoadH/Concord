{
  "name": "concord-sdlc",
  "version": "dev",
  "description": "Contract, test evidence, and engineering memory for a repository's development lifecycle.",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.4.4",
  "scripts": {
    "build": "bun --no-env-file --config=/dev/null --bun node_modules/vite/bin/vite.js build",
    "gate": "bun --no-env-file --config=/dev/null scripts/gate.ts",
    "concord": "bun --no-env-file --config=/dev/null src/entry/cli/entry.ts",
    "bench": "bun --no-env-file --config=/dev/null scripts/bench.ts",
    "bench:profile": "bun --no-env-file --config=/dev/null scripts/profile.ts",
    "build:herdr": "bun --no-env-file --config=/dev/null scripts/build-herdr-mod.ts",
    "build:native": "bun --no-env-file --config=/dev/null scripts/prepare-native.ts --all-modes",
    "dev": "bun --no-env-file --config=/dev/null --bun node_modules/vite/bin/vite.js",
    "gate:lint": "bun --no-env-file --config=/dev/null --bun node_modules/oxlint/bin/oxlint src web test scripts bench *.config.ts",
    "gate:selfhost": "bun --no-env-file --config=/dev/null src/entry/cli/entry.ts --json --dry-run check",
    "test:source": "bun --no-env-file --config=/dev/null scripts/test-built.ts",
    "gate:source": "bun --no-env-file --config=/dev/null node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "gate:tests": "bun --no-env-file --config=/dev/null node_modules/typescript/bin/tsc -p tsconfig.test.json --noEmit",
    "gate:scripts": "bun --no-env-file --config=/dev/null node_modules/typescript/bin/tsc -p tsconfig.scripts.json --noEmit",
    "gate:web": "bun --no-env-file --config=/dev/null node_modules/typescript/bin/tsc -p tsconfig.web.json --noEmit"
  },
  "dependencies": {
    "esbuild": "0.28.2",
    "typescript": "7.1.0-beta"
  },
  "devDependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@effect/platform-node": "4.1.2",
    "@fontsource-variable/noto-sans-sc": "5.3.1",
    "@lezer/highlight": "1.2.5",
    "@lezer/xml": "1.0.6",
    "@mdxeditor/editor": "4.5.0",
    "@stylexjs/stylex": "0.19.1",
    "@stylexjs/unplugin": "0.19.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/bun": "1.4.4",
    "@types/mdast": "4.0.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "effect": "4.1.2",
    "katex": "0.19.1",
    "lucide-react": "1.70.0",
    "mdast-util-from-markdown": "2.1.0",
    "oxlint": "1.92.0",
    "p5": "2.3.4",
    "p5.brush": "3.0.0",
    "p5.sound": "0.4.1",
    "pele": "1.13.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-diff-view": "3.3.3",
    "react-dom": "19.3.1",
    "react-grab": "0.2.0",
    "react-markdown": "10.1.0",
    "react-router-dom": "7.18.5",
    "rehype-katex": "7.0.1",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "rolldown": "1.3.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.5",
    "tsdown": "0.23.7",
    "tw-animate-css": "1.4.0",
    "unified": "11.0.5",
    "unplugin": "3.7.0",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "yaml": "2.9.1"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.1.2"
  },
  "patchedDependencies": {
    "typescript@7.1.0-beta": "patches/typescript@7.1.0-beta.patch"
  },
  "trustedDependencies": ["esbuild"]
}
